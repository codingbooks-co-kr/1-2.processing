// 덧셈 연산자인 ‘+’를 사용하여 문자열 병합

int i = 12;
float f = 12.345;
char c = 'A';
String s = "Processing";
println("i = " + i);
println("f = " + f);
println("c = " + c);
println("s = " + s);
println("Hello " + "Processing");
println(12 + 12.34);
println(12 + 12.34 + " = Sum");
println("Sum = " + 12 + 12.34);
